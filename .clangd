# .clangd
#
# stackide builds with GCC 16 by default, but clangd is Clang 23. Feeding it a
# GCC compile_commands.json means GCC-only flags and libstdc++ headers that
# Clang 23 may not parse. Point the symlink at the clang build instead:
#
#     ln -s build/clang/compile_commands.json compile_commands.json
#
# See docs/toolchain.md for why the IDE index comes from the clang build.

CompileFlags:
  CompilationDatabase: build/clang
  Add:
    - -Wno-unknown-warning-option
    - -Wno-unknown-attributes
  Remove:
    # GCC-only diagnostics that Clang rejects outright.
    - -Wduplicated-cond
    - -Wduplicated-branches
    - -Wlogical-op
    - -Wuseless-cast
    - -fconcepts-diagnostics-depth=*
    - -fno-lifetime-dse
    - -fdiagnostics-*

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Index:
  Background: Build
  StandardLibrary: Yes
