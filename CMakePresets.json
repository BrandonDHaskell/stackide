{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/gcc/bin/g++",
        "CMAKE_C_COMPILER": "/opt/gcc/bin/gcc",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc/lib64",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc/lib64"
      }
    },
    {
      "name": "clang",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/llvm/bin/clang++",
        "CMAKE_C_COMPILER": "/opt/llvm/bin/clang",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -Wl,-rpath,/opt/llvm/lib/x86_64-unknown-linux-gnu",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -Wl,-rpath,/opt/llvm/lib/x86_64-unknown-linux-gnu"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc", "configurePreset": "gcc" },
    { "name": "clang", "configurePreset": "clang" }
  ],
  "testPresets": [
    { "name": "gcc", "configurePreset": "gcc", "output": { "outputOnFailure": true } },
    { "name": "clang", "configurePreset": "clang", "output": { "outputOnFailure": true } }
  ]
}